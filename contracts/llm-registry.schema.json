{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/shadow-llm-registry-v1.json",
  "title": "Shadow LLM Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers", "models"],
  "properties": {
    "version": { "const": 1 },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "apps": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["models"],
        "properties": {
          "models": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": { "$ref": "#/$defs/modelOverride" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "base_url", "credential_file"],
      "properties": {
        "protocol": {
          "enum": ["openai-compatible", "anthropic"]
        },
        "api": {
          "enum": ["responses", "chat-completions", "messages"]
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "credential_file": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/id" },
        "api": {
          "enum": ["responses", "chat-completions", "messages"]
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 255 },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "fallbacks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "modelOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "provider": { "$ref": "#/$defs/id" },
        "api": {
          "enum": ["responses", "chat-completions", "messages"]
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 255 },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "fallbacks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
