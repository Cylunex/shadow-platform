{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/shadow-agent-registry-v1.json",
  "title": "Shadow Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agents"],
  "properties": {
    "version": { "const": 1 },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_app", "audiences", "scopes", "credential_hash_files"],
      "properties": {
        "owner_app": { "$ref": "#/$defs/id" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope" }
        },
        "credential_hash_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "disabled": { "type": "boolean", "default": false }
      }
    }
  }
}
