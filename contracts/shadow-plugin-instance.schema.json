{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/shadow-plugin-instance-v1.json",
  "title": "Shadow Plugin Instance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "instances"],
  "properties": {
    "version": { "const": 1 },
    "instances": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/instance" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "env_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "plugin_version",
        "environment",
        "enabled"
      ],
      "properties": {
        "plugin_id": { "$ref": "#/$defs/id" },
        "plugin_version": { "$ref": "#/$defs/semver" },
        "environment": { "enum": ["development", "test", "production"] },
        "base_url_env": { "$ref": "#/$defs/env_name" },
        "credential_env": { "$ref": "#/$defs/env_name" },
        "health_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"
        },
        "context_env": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/env_name" }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server_name", "transport", "fail_on_startup_error", "reconnect"],
          "properties": {
            "server_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            },
            "transport": { "enum": ["streamable-http", "stdio"] },
            "url_env": { "$ref": "#/$defs/env_name" },
            "bearer_token_env": { "$ref": "#/$defs/env_name" },
            "command": { "type": "string", "minLength": 1, "maxLength": 512 },
            "args": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "maxLength": 2048 }
            },
            "cwd_env": { "$ref": "#/$defs/env_name" },
            "env_forward": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/env_name" }
            },
            "tool_call_timeout_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "fail_on_startup_error": { "type": "boolean" },
            "reconnect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "initial_delay_ms", "max_delay_ms", "max_attempts"],
              "properties": {
                "enabled": { "type": "boolean" },
                "initial_delay_ms": { "type": "integer", "minimum": 1 },
                "max_delay_ms": { "type": "integer", "minimum": 1 },
                "max_attempts": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "transport": { "const": "streamable-http" } } },
              "then": { "required": ["url_env", "bearer_token_env"] }
            },
            {
              "if": { "properties": { "transport": { "const": "stdio" } } },
              "then": { "required": ["command", "args", "env_forward"] }
            }
          ]
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
