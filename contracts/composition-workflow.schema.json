{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/shadow-composition-workflow-v1.json",
  "title": "Shadow Composition Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workflows"],
  "properties": {
    "version": { "const": 1 },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "parameters", "steps"],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "parameters": { "type": "object" },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "capability_id", "tool_name", "arguments", "optional"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
                "capability_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "tool_name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "arguments": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["from_argument"],
                        "properties": {
                          "from_argument": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                          },
                          "required": { "type": "boolean" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["value"],
                        "properties": { "value": true }
                      }
                    ]
                  }
                },
                "optional": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
