{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/shadow-restore-drill-v1.json",
  "title": "Shadow Backup Restore Drill",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "protocol", "drill_id", "project_id", "deployment_id", "build_id", "capability_refs", "correlation", "backup", "restore", "checks"],
  "properties": {
    "version": { "const": 1 },
    "protocol": { "const": "shadow.restore-drill.v1" },
    "drill_id": { "$ref": "#/$defs/safe_id" },
    "project_id": { "$ref": "#/$defs/id" },
    "deployment_id": { "$ref": "#/$defs/id" },
    "build_id": { "$ref": "#/$defs/sha256" },
    "capability_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^shadow://capabilities/[a-z][a-z0-9-]{1,63}/[a-z][a-z0-9-]{1,63}/[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }
    },
    "correlation": { "$ref": "#/$defs/correlation" },
    "backup": {
      "type": "object", "additionalProperties": false,
      "required": ["backup_id", "created_at", "immutable", "sha256"],
      "properties": {
        "backup_id": { "$ref": "#/$defs/safe_id" }, "created_at": { "type": "string", "format": "date-time" },
        "immutable": { "const": true }, "sha256": { "$ref": "#/$defs/sha256" },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "restore": {
      "type": "object", "additionalProperties": false,
      "required": ["source_backup_id", "target_kind", "production", "started_at", "completed_at", "cleanup_completed", "rpo_seconds", "rto_seconds"],
      "properties": {
        "source_backup_id": { "$ref": "#/$defs/safe_id" }, "target_kind": { "const": "isolated" },
        "production": { "const": false }, "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }, "cleanup_completed": { "const": true },
        "rpo_seconds": { "type": "integer", "minimum": 0 }, "rto_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/check" } },
    "artifacts": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safe_id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$" },
    "correlation": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "correlation_id", "trace_id", "request_id"],
      "properties": {
        "run_id": { "$ref": "#/$defs/safe_id" }, "correlation_id": { "$ref": "#/$defs/safe_id" },
        "trace_id": { "$ref": "#/$defs/safe_id" }, "request_id": { "$ref": "#/$defs/safe_id" },
        "causation_id": { "$ref": "#/$defs/safe_id" }, "idempotency_key": { "$ref": "#/$defs/safe_id" }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["name", "category", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "category": { "enum": ["contract", "client", "deployment", "data", "health", "security"] },
        "status": { "enum": ["passed", "failed"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
