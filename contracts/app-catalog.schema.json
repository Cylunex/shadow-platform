{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/shadow-app-catalog-v1.json",
  "title": "Shadow Application Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "apps"],
  "properties": {
    "version": { "const": 1 },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "owner",
        "lifecycle",
        "kind",
        "canonical_url",
        "auth",
        "health_path",
        "media",
        "llm_models",
        "agent_audience"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "owner": { "$ref": "#/$defs/id" },
        "lifecycle": { "enum": ["experimental", "production", "deprecated"] },
        "kind": { "enum": ["web", "service", "mobile", "library"] },
        "canonical_url": {
          "anyOf": [
            { "$ref": "#/$defs/httpsUrl" },
            { "type": "null" }
          ]
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUrl" }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "groups"],
          "properties": {
            "mode": {
              "enum": ["public", "public-with-protected-paths", "forward-auth", "oidc"]
            },
            "groups": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        },
        "health_path": {
          "anyOf": [
            { "type": "string", "pattern": "^/", "maxLength": 255 },
            { "type": "null" }
          ]
        },
        "media": { "type": "boolean" },
        "llm_models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "agent_audience": { "type": "boolean" }
      }
    }
  }
}
