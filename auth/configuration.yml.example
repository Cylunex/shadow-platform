---
theme: dark

server:
  address: 'tcp://127.0.0.1:9091/'

log:
  level: info

totp:
  issuer: Cylunex

webauthn:
  display_name: Shadow Identity

authentication_backend:
  password_reset:
    disable: false
  refresh_interval: 5m
  file:
    path: /config/users_database.yml
    password:
      algorithm: argon2
      argon2:
        variant: argon2id
        iterations: 3
        memory: 65536
        parallelism: 4
        key_length: 32
        salt_length: 16

access_control:
  default_policy: deny
  rules:
    - domain: cylunex.top
      resources:
        - '^/admin(?:/.*)?$'
      subject:
        - 'group:garden-admins'
      policy: one_factor
    - domain: nas.cylunex.top
      resources:
        - '^/shealth/healthz$'
        - '^/stock/api/health$'
      policy: bypass
    - domain: nas.cylunex.top
      resources:
        - '^/shealth(?:/.*)?$'
      subject:
        - 'group:health-users'
      policy: one_factor
    - domain: nas.cylunex.top
      resources:
        - '^/stock(?:/.*)?$'
      subject:
        - 'group:stock-users'
      policy: one_factor

session:
  name: shadow_identity_session
  same_site: lax
  inactivity: 30m
  expiration: 12h
  remember_me: 30d
  cookies:
    - domain: cylunex.top
      authelia_url: https://auth.cylunex.top
      default_redirection_url: https://cylunex.top
  redis:
    host: 127.0.0.1
    port: 6379
    database_index: 2
    username: authelia

regulation:
  max_retries: 5
  find_time: 10m
  ban_time: 15m

storage:
  postgres:
    address: 'tcp://127.0.0.1:5432'
    database: authelia
    schema: public
    username: authelia

notifier:
  filesystem:
    filename: /config/notification.txt

# 生产密钥通过以下 *_FILE 环境变量注入，不写在本文件：
# AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE
# AUTHELIA_SESSION_SECRET_FILE
# AUTHELIA_SESSION_REDIS_PASSWORD_FILE
# AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE
# AUTHELIA_STORAGE_POSTGRES_PASSWORD_FILE
# AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE
#
# OIDC 的 JWKS 私钥和 clients 在锁定 Authelia 版本后，按
# oidc-clients.yml.example 与官方配置校验结果合并。
