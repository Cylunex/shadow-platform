# 该模板仅适用于本地/NAS 存储后端。OSS 直传不会经过此请求体入口。
log_format shadow_media '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                        '$status $body_bytes_sent request_id=$request_id';

server {
    listen 80;
    server_name media.cylunex.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name media.cylunex.top;

    # ssl_certificate /etc/letsencrypt/live/cylunex.top/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/cylunex.top/privkey.pem;

    # 日志使用 $uri 而不是 $request_uri，避免记录私密访问 token。
    access_log /var/log/nginx/shadow-media.access.log shadow_media;
    client_max_body_size 16m;

    location / {
        limit_except GET POST PUT DELETE OPTIONS { deny all; }

        proxy_pass http://127.0.0.1:8400;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }
}
