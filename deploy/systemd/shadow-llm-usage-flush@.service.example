[Unit]
Description=Flush Shadow LLM usage outbox for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/opt/shadow-platform
EnvironmentFile=/etc/shadow-platform/llm-telemetry-%i.env
ExecStart=/opt/shadow-platform/.venv/bin/python scripts/flush_llm_usage.py --outbox ${SHADOW_LLM_USAGE_OUTBOX} --endpoint ${SHADOW_LLM_TELEMETRY_ENDPOINT} --token-file ${SHADOW_LLM_SERVICE_TOKEN_FILE}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/%i

[Install]
WantedBy=multi-user.target
