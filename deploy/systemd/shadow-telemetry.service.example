[Unit]
Description=Shadow LLM Telemetry API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=shadow-platform
Group=shadow-platform
WorkingDirectory=/opt/shadow-platform
EnvironmentFile=/etc/shadow-platform/telemetry.env
ExecStart=/opt/shadow-platform/.venv/bin/uvicorn telemetry_service.app:app --host 127.0.0.1 --port 8410 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shadow-telemetry

[Install]
WantedBy=multi-user.target
