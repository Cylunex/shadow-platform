[Unit]
Description=Shadow Notifications API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=shadow-platform
Group=shadow-platform
WorkingDirectory=/opt/shadow-platform
EnvironmentFile=/etc/shadow-platform/notification.env
ExecStart=/opt/shadow-platform/.venv/bin/uvicorn notification_service.app:app --host 127.0.0.1 --port 8420 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/shadow-platform

[Install]
WantedBy=multi-user.target
