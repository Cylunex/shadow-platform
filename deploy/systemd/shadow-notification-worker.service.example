[Unit]
Description=Shadow Notification Delivery Worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=shadow-platform
Group=shadow-platform
WorkingDirectory=/opt/shadow-platform
EnvironmentFile=/etc/shadow-platform/notification.env
ExecStart=/opt/shadow-platform/.venv/bin/shadow-notify-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/shadow-platform

[Install]
WantedBy=multi-user.target
