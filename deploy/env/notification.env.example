SHADOW_ENV=production
SHADOW_NOTIFY_DATABASE_URL_FILE=/etc/shadow-platform/secrets/notification-database-url
SHADOW_NOTIFY_SERVICE_TOKEN_HASHES_FILE=/etc/shadow-platform/secrets/notification-token-hashes.json
SHADOW_NOTIFY_CHANNEL_CONFIG_FILE=/etc/shadow-platform/notification-channels.yml
SHADOW_NOTIFY_OIDC_ISSUER=https://auth.example.com
SHADOW_NOTIFY_OIDC_CLIENT_ID=shadow-notifications
SHADOW_NOTIFY_OIDC_CLIENT_SECRET_FILE=/etc/shadow-platform/secrets/notification-oidc-client-secret
SHADOW_NOTIFY_SESSION_SECRET_FILE=/etc/shadow-platform/secrets/notification-session-secret
SHADOW_NOTIFY_OIDC_CALLBACKS='["https://notify.example.com/auth/callback"]'
SHADOW_NOTIFY_ALLOWED_ORIGINS='["https://notify.example.com"]'
SHADOW_NOTIFY_ADMIN_GROUP=shadow-admins
SHADOW_NOTIFY_CHAT_GATEWAY_APPS='["hermes", "openclaw"]'
SHADOW_NOTIFY_DEV_AUTH=false
SHADOW_NOTIFY_MAX_ATTEMPTS=8
SHADOW_NOTIFY_RETENTION_DAYS=180
SHADOW_NOTIFY_PROBE_INTERVAL_SECONDS=60
