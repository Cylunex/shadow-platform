SHADOW_ENV=production
SHADOW_MEDIA_DATABASE_URL_FILE=/etc/shadow-platform/secrets/media-database-url
SHADOW_MEDIA_STORAGE_ROOT=/var/lib/shadow-media/objects
SHADOW_MEDIA_PUBLIC_BASE_URL=https://media.example.com
SHADOW_MEDIA_SERVICE_TOKEN_HASHES_FILE=/etc/shadow-platform/secrets/service-token-hashes.json
SHADOW_MEDIA_ACCESS_SIGNING_KEY_FILE=/etc/shadow-platform/secrets/media-access-signing-key
SHADOW_MEDIA_MAX_UPLOAD_BYTES=15728640
SHADOW_MEDIA_UPLOAD_TTL_SECONDS=900
SHADOW_MEDIA_ACCESS_TTL_SECONDS=300
SHADOW_MEDIA_SOFT_DELETE_RETENTION_DAYS=7
SHADOW_MEDIA_STRIP_METADATA=true
SHADOW_ASSET_MAX_UPLOAD_BYTES=536870912
SHADOW_ASSET_UPLOAD_TTL_SECONDS=86400
SHADOW_ASSET_TRASH_RETENTION_DAYS=30
SHADOW_ASSET_ORPHAN_GRACE_DAYS=7
SHADOW_ASSET_BLOB_GC_MIN_AGE_HOURS=24
# 可选：受控的直传备用入口，逗号分隔。生产默认只允许 HTTPS。
# SHADOW_ASSET_UPLOAD_BASE_URLS=https://nas.example.com/platform/assets
# 仅在受信局域网且客户端明确允许明文时启用；公网入口仍必须 HTTPS。
# SHADOW_ASSET_ALLOW_INSECURE_UPLOAD_TARGETS=false
# 浏览器直传所需的精确 Origin，不允许 *。
# SHADOW_ASSET_CORS_ORIGINS=https://garden.example.com
