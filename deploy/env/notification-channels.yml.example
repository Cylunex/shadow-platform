version: 1

# 真实 token/AppSecret 只从受限文件读取；禁用账号不会读取文件，便于先完成配置审查。
accounts:
  telegram:
    default:
      enabled: false
      token_file: /etc/shadow-platform/secrets/channels/telegram-default-token
  feishu:
    default:
      enabled: false
      app_id: REPLACE_FEISHU_APP_ID
      app_secret_file: /etc/shadow-platform/secrets/channels/feishu-default-secret
      domain: feishu
  qqbot:
    default:
      enabled: false
      app_id: REPLACE_QQ_BOT_APP_ID
      app_secret_file: /etc/shadow-platform/secrets/channels/qqbot-default-secret

# home target 接收主动通知。群/频道必须显式填写 categories，避免把所有业务通知发进群。
# 群默认 require_mention=true；command_level=safe 只允许 /help、/status。
targets: []
# - recipient:
#     issuer: https://auth.example.com
#     subject: REPLACE_OIDC_SUBJECT
#   channel: telegram
#   account_id: default
#   target_kind: group
#   target_id: REPLACE_TELEGRAM_CHAT_ID
#   thread_id: ""
#   label: Shadow Ops
#   enabled: true
#   is_home: true
#   min_severity: warning
#   categories: [platform.ops, travel.reminder]
#   require_mention: true
#   command_level: safe

# 把 Hermes/OpenClaw 归一化的 sender ID 映射回 OIDC 身份。operator 才能在私聊执行 /ops。
principals: []
# - recipient:
#     issuer: https://auth.example.com
#     subject: REPLACE_OIDC_SUBJECT
#   channel: telegram
#   account_id: default
#   sender_id: REPLACE_TELEGRAM_USER_ID
#   role: operator
#   enabled: true

# 仅允许显式 loopback URL，避免运维探活成为 SSRF 跳板。
probes:
  - service_id: media
    url: http://127.0.0.1:8400/readyz
  - service_id: telemetry
    url: http://127.0.0.1:8410/readyz
  - service_id: notifications
    url: http://127.0.0.1:8420/readyz
