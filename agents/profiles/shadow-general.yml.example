version: 1
id: shadow-general
runtime:
  kind: dsh
  distribution_version: 0.1.1-rc.2
  tools_api_version: 0.1.1-rc.2
  mcp_client_version: 0.1.1-rc.2
plugins:
  - plugin_id: shadow-travel
    instance_id: travel-production
    capabilities: "*"
  - plugin_id: shadow-archive
    instance_id: archive-production
    capabilities: "*"
policy:
  preauthorized_capabilities: []
  allow_elevated: true
  confirmation:
    issuer: shadow-general
    key_id: REPLACE_WITH_CONFIRMATION_KEY_ID
    algorithm: EdDSA
    private_key_file_env: SHADOW_CONFIRMATION_PRIVATE_KEY_FILE
    ttl_seconds: 300
budgets:
  max_tool_catalog_chars: 60000
  max_skill_catalog_chars: 12000
