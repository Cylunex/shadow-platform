version: 1
instances:
  travel-production:
    plugin_id: shadow-travel
    plugin_version: 0.1.0
    environment: production
    base_url_env: SHADOW_TRAVEL_BASE_URL
    credential_env: SHADOW_TRAVEL_AGENT_TOKEN
    health_path: /healthz
    enabled: true
  archive-production:
    plugin_id: shadow-archive
    plugin_version: 0.1.0
    environment: production
    base_url_env: SHADOW_ARCHIVE_BASE_URL
    credential_env: SHADOW_ARCHIVE_AGENT_TOKEN
    health_path: /healthz
    enabled: true
  health-production:
    plugin_id: shadow-health
    plugin_version: 0.1.0
    environment: production
    base_url_env: SHADOW_HEALTH_BASE_URL
    credential_env: SHADOW_HEALTH_AGENT_TOKEN
    health_path: /healthz
    context_env:
      profile_id: SHADOW_HEALTH_PROFILE_ID
    enabled: true
  ledger-production:
    plugin_id: shadow-ledger
    plugin_version: 1.0.0
    environment: production
    base_url_env: SHADOW_LEDGER_BASE_URL
    credential_env: SHADOW_LEDGER_AGENT_TOKEN
    health_path: /healthz
    enabled: true
  garden-production:
    plugin_id: shadow-garden
    plugin_version: 0.1.0
    environment: production
    base_url_env: SHADOW_GARDEN_BASE_URL
    credential_env: SHADOW_GARDEN_AGENT_TOKEN
    health_path: /healthz
    enabled: true
  daily-overview-production:
    plugin_id: shadow-daily-overview
    plugin_version: 1.0.0
    environment: production
    enabled: true
