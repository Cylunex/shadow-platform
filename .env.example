SHADOW_ENV=development
SHADOW_MEDIA_DATABASE_URL=sqlite:///./data/media.db
SHADOW_MEDIA_STORAGE_ROOT=./uploads
SHADOW_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8400
SHADOW_MEDIA_SERVICE_TOKEN_HASHES_FILE=./secrets/service-token-hashes.json
SHADOW_MEDIA_ACCESS_SIGNING_KEY_FILE=./secrets/media-access-signing-key
SHADOW_MEDIA_MAX_UPLOAD_BYTES=15728640
SHADOW_MEDIA_UPLOAD_TTL_SECONDS=900
SHADOW_MEDIA_ACCESS_TTL_SECONDS=300
SHADOW_MEDIA_SOFT_DELETE_RETENTION_DAYS=7
SHADOW_MEDIA_STRIP_METADATA=true
SHADOW_ASSET_MAX_UPLOAD_BYTES=536870912
SHADOW_ASSET_UPLOAD_TTL_SECONDS=86400
SHADOW_ASSET_TRASH_RETENTION_DAYS=30
SHADOW_ASSET_ORPHAN_GRACE_DAYS=7
SHADOW_ASSET_BLOB_GC_MIN_AGE_HOURS=24

SHADOW_TELEMETRY_DATABASE_URL=sqlite:///./data/telemetry.db
SHADOW_TELEMETRY_SERVICE_TOKEN_HASHES_FILE=./secrets/service-token-hashes.json
SHADOW_TELEMETRY_RETENTION_DAYS=400

SHADOW_NOTIFY_DATABASE_URL=sqlite:///./data/notifications.db
SHADOW_NOTIFY_SERVICE_TOKEN_HASHES_FILE=./secrets/notification-token-hashes.json
SHADOW_NOTIFY_CHANNEL_CONFIG_FILE=./config/notification-channels.local.yml
SHADOW_NOTIFY_OIDC_ISSUER=https://auth.example.com
SHADOW_NOTIFY_OIDC_CLIENT_ID=shadow-notifications
SHADOW_NOTIFY_OIDC_CLIENT_SECRET_FILE=./secrets/notification-oidc-client-secret
SHADOW_NOTIFY_SESSION_SECRET_FILE=./secrets/notification-session-secret
SHADOW_NOTIFY_OIDC_CALLBACKS='["https://notify.example.com/auth/callback"]'
SHADOW_NOTIFY_ALLOWED_ORIGINS='["https://notify.example.com"]'
SHADOW_NOTIFY_ADMIN_GROUP=shadow-admins
SHADOW_NOTIFY_CHAT_GATEWAY_APPS='["hermes", "openclaw"]'
SHADOW_NOTIFY_DEV_AUTH=false
SHADOW_NOTIFY_MAX_ATTEMPTS=8
SHADOW_NOTIFY_RETENTION_DAYS=180
SHADOW_NOTIFY_PROBE_INTERVAL_SECONDS=60
